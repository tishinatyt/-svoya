{
  "name": "svoya-women-club",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-pages.mjs",
    "preview": "vite preview",
    "test:paths": "node --experimental-strip-types --test tests/site-path.test.ts tests/service-worker.test.mjs",
    "test:community": "node --experimental-strip-types --test tests/community.test.ts",
    "test": "node --import tsx --experimental-test-module-mocks --test tests/*.test.ts tests/*.test.tsx tests/*.test.mjs",
    "test:db": "node scripts/test-db.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "typecheck": "tsc -b",
    "local:start": "supabase start --workdir supabase-svoya --exclude realtime,imgproxy,postgres-meta,studio,logflare,vector,supavisor",
    "local:stop": "supabase stop --workdir supabase-svoya",
    "local:env": "node scripts/local-env.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.103.3",
    "@types/leaflet": "^1.9.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "1.31.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "jsdom": "30.1.2",
    "supabase": "2.120.0",
    "tailwindcss": "^4.1.11",
    "tsx": "4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
