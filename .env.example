# Public frontend configuration from Supabase Dashboard → Project Settings → API.
# Never place a service-role key, database password, or personal token here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# App
VITE_APP_URL=http://localhost:5173/

# Optional local-only demo cards. Production builds always ignore this flag.
VITE_ENABLE_DEMO_EVENTS=false
